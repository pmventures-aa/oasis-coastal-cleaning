/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Logos, favicons and social images never change — cache them hard.
/logo/*
  Cache-Control: public, max-age=31536000, immutable
/favicon/*
  Cache-Control: public, max-age=31536000, immutable
/social/*
  Cache-Control: public, max-age=31536000, immutable
/print/*
  Cache-Control: public, max-age=31536000, immutable

# The fonts are large and never change, and bump-version.sh stamps a version
# onto their URLs in both the <link rel="preload"> and the url() in tokens.css,
# so each deploy's URL is new and a year-long cache can never serve a stale one.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Styles and scripts are stamped too, so in principle they could be cached just
# as hard. They are not, on purpose. The stamp comes from remembering to run
# bump-version.sh, and the one time that was forgotten a finished design sat
# invisible behind a day-old cache. Revalidating costs one conditional request
# for a file of a few tens of KB and returns a 304 when nothing changed, which
# is a cheap premium against shipping a deploy nobody can see.
/css/*
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/tokens.css
  Cache-Control: public, max-age=0, must-revalidate
